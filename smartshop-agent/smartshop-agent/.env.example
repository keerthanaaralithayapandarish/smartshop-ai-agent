# --- LLM ---
# Leave ANTHROPIC_API_KEY empty to run in offline "rule-based" mode (no LLM needed).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Backend wiring ---
# mock  = use built-in sample data (works standalone, for development)
# http  = call Member 3 and Member 4 services over HTTP (for integration)
BACKEND_MODE=mock
PRODUCT_API_URL=http://localhost:8001
INVENTORY_API_URL=http://localhost:8002

# --- Frontend (React dev server) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
